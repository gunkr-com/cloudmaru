# PGlite 데이터 폴더. 저장소 밖 권장. worktree 개발 서버는 별도 폴더를 사용한다.
CLOUDSIGHT_DATA_DIR=~/.cloudsight/data

# 추가 허용 호스트 이름 (쉼표 구분). 예: Tailscale MagicDNS 이름. 와일드카드는 지원하지 않는다.
# 다른 기기에서 접근할 때도 바인딩은 127.0.0.1 그대로 두고 `tailscale serve`로 tailnet에만 내보낸다.
# -H 0.0.0.0은 쓰지 않는다. Host·Origin 헤더는 브라우저가 아닌 도구가 마음대로 붙일 수 있어 바인딩이 유일한 네트워크 경계다.
CLOUDSIGHT_ALLOWED_HOSTS=
# Optional development-only HMR hosts; no personal machine names are bundled.
CLOUDSIGHT_DEV_ORIGINS=
# Server-only private key files. Keep outside the repository and database.
CLOUDSIGHT_SECRETS_DIR=

# 개발용 eval 전용 키. 앱의 워크스페이스 분석에는 사용하지 않는다.
ANTHROPIC_API_KEY=
# 워크스페이스별 전용 키. 키 값은 로컬 파일에만 넣고, 설정 화면에는 변수 이름만 저장한다.
# CLOUDSIGHT_CLAUDE_KEY_ACME=
# Claude 모델 ID (claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# Extend Bicep only: exact local CLI 0.49.2 (b34271ac51), ARM generator 0.49.2.45890.
# Accepts only bicep or one absolute executable path (spaces supported); no shell command/arguments.
# If unset, bicep is resolved only on:
# /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
# CLOUDSIGHT_BICEP_PATH=/absolute/path/to/bicep
# Real compiler tests use CLOUDSIGHT_TEST_BICEP_PATH separately; this does not configure the app.
# Saved successful artifacts need neither the compiler nor a Claude key to reopen/download.
# Setup and failure recovery: docs/SELF_HOSTING.md#native-bicep-compiler

# 워크스페이스 Azure 연결에 아래 환경 변수 이름을 적는다. 비밀번호 없는 PEM이면 필요 없다.
# CLOUDSIGHT_CERT_PASSWORD_CONTOSO=

# Optional absolute path for the locally synced pricing file.
CLOUDMARU_PRICES_FILE=
