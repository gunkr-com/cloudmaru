          {
            "from": "static-web-apps-standard",
            "to": "functions-consumption-executions"
          },
          {
            "from": "functions-consumption-executions",
            "to": "postgres-flex-gp-2vcore"
          },
          {
            "from": "functions-consumption-executions",
            "to": "blob-hot-lrs"
          }
        ],
        "pros": [
          {
            "en": "Static Web Apps deploys static pages; consumption Functions scales the API with requests.",
            "ko": "Static Web Apps에서 정적 화면을 배포하고 소비형 Functions가 요청량에 따라 API를 확장한다."
          },
          {
            "en": "General-purpose PostgreSQL and Key Vault manage production data and API secrets.",
            "ko": "범용 PostgreSQL과 Key Vault를 사용해 운영 데이터와 API의 비밀 값을 관리한다."
          }
        ],
        "cons": [
          {
            "en": "A consumption API and single database do not withstand zone failures; the first request after idle may be slow.",
            "ko": "소비형 API와 단일 DB는 영역 장애를 견디는 구성이 아니며, 유휴 후 첫 요청이 느려질 수 있다."
