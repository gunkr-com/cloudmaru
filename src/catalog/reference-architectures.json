          "en": "Production setup with an autoscaling API and general-purpose database",
          "ko": "자동 확장 API와 범용 DB의 운영 구성"
        },
        "items": [
          {
            "componentId": "static-web-apps-standard",
            "quantity": 1
          },
          {
            "componentId": "functions-consumption-executions",
            "quantity": 1000000
          },
          {
            "componentId": "functions-consumption-duration",
